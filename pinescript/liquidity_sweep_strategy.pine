//@version=5
// =============================================================================
// Liquidity Sweep — STRATEGY version (for TradingView's Strategy Tester)
//
// Same signal pipeline as pinescript/liquidity_sweep_indicator.pine (sweep ->
// HTF bias -> displacement -> FVG -> retest), plus entries/exits so the
// Strategy Tester tab shows win rate / PF / drawdown on real history --
// trades the underlying (spot/futures) directly, since Pine strategies can't
// simulate option premium. Read this as "does the SIGNAL have edge on the
// underlying," not as a stand-in for the real options P&L (theta/IV are not
// modeled here at all -- that only happens once this is ported to Python).
//
// Exit rules per execution/risk_engine.py (SL/Target1 formulas confirmed by
// direct inspection; Target2 and any trailing-stop mechanic were NOT found
// in that file, so they're flagged below as reasonable placeholders, not
// confirmed repo behavior):
//   SL      = the swept candle's own extreme (spot_structural_sl) -- for a
//             bullish setup (swept a low), SL sits below that sweep candle's
//             low; for bearish, above its high. CONFIRMED shape (risk_engine.py's
//             spot_risk_points = abs(spot_entry - spot_structural_sl)).
//   Target1 = entry + risk_distance * target1_rr. CONFIRMED formula; the
//             actual target1_rr default was NOT visible in what was fetched
//             -- tune tgt1RR below.
//   Target2 = entry + risk_distance * target2_rr. The real repo defines this
//             as "opposing PDH/PDL or unmitigated HTF zone" (structural, not
//             a fixed R-multiple) -- NOT implemented here as such; this is a
//             flagged simplification (a second, larger R-multiple) so the
//             Strategy Tester has something to show today. Revisit once the
//             indicator side is confirmed and before trusting these numbers.
//   TSL     = no trailing-stop logic was found in risk_engine.py at all. This
//             script adds an optional move-to-breakeven-after-Target1 as a
//             common, defensible placeholder -- toggle off if you want the
//             raw SL/Target1/Target2 read with nothing else added.
// =============================================================================
strategy("Liquidity Sweep (Sweep+Displacement+FVG+Retest) - Strategy",
     overlay=true, default_qty_type=strategy.fixed, default_qty_value=1,
     process_orders_on_close=true, calc_on_every_tick=false,
     max_boxes_count=500, max_labels_count=500)

// ── Inputs ───────────────────────────────────────────────────────────────
grpHTF = "HTF Rolling Base"
htfTF     = input.timeframe("75", "HTF timeframe (rolling base)", group=grpHTF)

grpDisp = "Displacement"
atrLen    = input.int(14, "ATR lookback (simple avg of H-L, no smoothing)", minval=1, group=grpDisp)
atrMult   = input.float(1.5, "Displacement threshold: body / ATR >", minval=0.1, step=0.1, group=grpDisp)
dispWindow= input.int(6, "Displacement window (candles after sweep)", minval=1, group=grpDisp,
     tooltip="Widened from the source repo's implied default (2) after a live MCX Crude 5m chart showed the real displacement move routinely landing later than 2-3 candles after the sweep. Re-tune per instrument/timeframe.")
swingLen  = input.int(3, "Micro-swing lookback (bars each side)", minval=1, group=grpDisp)

grpFVG = "FVG / Retest"
staleBars = input.int(12, "Retest staleness (LTF candles)", minval=1, group=grpFVG)

grpTime = "Time Filters (optional)"
useTimeFilter = input.bool(false, "Enable high-probability / blocked windows", group=grpTime)
hpWindow  = input.session("0920-1100", "High-probability window (only allow entries)", group=grpTime)
blockedWindow = input.session("1130-1330", "Blocked window (low-volume chop)", group=grpTime)

grpRisk = "Risk / Targets (see header comment -- Target2/TSL are flagged approximations)"
tgt1RR   = input.float(1.5, "Target 1 R-multiple", minval=0.1, step=0.1, group=grpRisk)
tgt1Pct  = input.float(50.0, "Book % of position at Target 1", minval=0, maxval=100, group=grpRisk)
tgt2RR   = input.float(3.0, "Target 2 R-multiple (NOT confirmed repo logic -- see header)", minval=0.1, step=0.1, group=grpRisk)
useBreakeven = input.bool(true, "Move SL to breakeven after Target 1 (NOT confirmed repo logic -- see header)", group=grpRisk)

// ── HTF rolling base (last CLOSED htf bar vs. the one before it — no repaint) ──
htf_c1 = request.security(syminfo.tickerid, htfTF, close[1], lookahead=barmerge.lookahead_off)
htf_h1 = request.security(syminfo.tickerid, htfTF, high[1],  lookahead=barmerge.lookahead_off)
htf_l1 = request.security(syminfo.tickerid, htfTF, low[1],   lookahead=barmerge.lookahead_off)
htf_h2 = request.security(syminfo.tickerid, htfTF, high[2],  lookahead=barmerge.lookahead_off)
htf_l2 = request.security(syminfo.tickerid, htfTF, low[2],   lookahead=barmerge.lookahead_off)
htf_t1 = request.security(syminfo.tickerid, htfTF, time[1],  lookahead=barmerge.lookahead_off)
newHtfClose = ta.change(htf_t1) != 0

var float baseHigh = na
var float baseLow  = na

if newHtfClose and htf_c1 > htf_h2
    baseHigh := htf_h1
    baseLow  := htf_l1
else if newHtfClose and htf_c1 < htf_l2
    baseHigh := htf_h1
    baseLow  := htf_l1

plot(baseHigh, "Base High", color=color.new(color.orange, 0), style=plot.style_stepline, linewidth=1)
plot(baseLow,  "Base Low",  color=color.new(color.orange, 0), style=plot.style_stepline, linewidth=1)

// ── HTF bias ─────────────────────────────────────────────────────────────
baseMid = (baseHigh + baseLow) / 2
bias = na(baseMid) ? 0 : (close > baseMid ? 1 : close < baseMid ? -1 : 0)

// ── Sweep ────────────────────────────────────────────────────────────────
rawBearSweep = not na(baseHigh) and high > baseHigh and close < baseHigh
rawBullSweep = not na(baseLow)  and low  < baseLow  and close > baseLow
bearSweepOK = rawBearSweep and bias != 1
bullSweepOK = rawBullSweep and bias != -1

plotshape(bearSweepOK, title="Sweep High (armed)", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
plotshape(bullSweepOK, title="Sweep Low (armed)",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small)

// ── Pending sweep -> displacement window ────────────────────────────────────
var int   pendingDir      = 0
var int   pendingBarsLeft = 0
var float sweepExtreme    = na   // the swept candle's own high/low -- becomes the structural SL anchor
justArmed = false

if bearSweepOK and pendingDir == 0
    pendingDir := -1
    pendingBarsLeft := dispWindow
    sweepExtreme := high
    justArmed := true
if bullSweepOK and pendingDir == 0
    pendingDir := 1
    pendingBarsLeft := dispWindow
    sweepExtreme := low
    justArmed := true

microHi = ta.highest(high[1], swingLen)
microLo = ta.lowest(low[1], swingLen)
atrSimple = ta.sma(high - low, atrLen)
body = math.abs(close - open)
dispRatio = atrSimple > 0 ? body / atrSimple : 0.0

dispBull = pendingDir == 1  and close > open and close > microHi and dispRatio > atrMult
dispBear = pendingDir == -1 and close < open and close < microLo and dispRatio > atrMult
plotshape(dispBull or dispBear, title="Displacement", style=shape.diamond, location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny)

var float dispC1Hi = na
var float dispC1Lo = na
var bool  awaitFvgConfirm = false
var int   awaitFvgDir = 0
var float armedSweepExtreme = na   // carried forward from sweep-arm time into the FVG/retest stage

if dispBull or dispBear
    dispC1Hi := high[1]
    dispC1Lo := low[1]
    awaitFvgConfirm := true
    awaitFvgDir := dispBull ? 1 : -1
    armedSweepExtreme := sweepExtreme
    pendingDir := 0
else if pendingDir != 0 and not justArmed
    pendingBarsLeft := pendingBarsLeft - 1
    if pendingBarsLeft <= 0
        pendingDir := 0

// ── FVG confirmation + retest arm ───────────────────────────────────────────
var int   fvgDir  = 0
var float fvgHi   = na
var float fvgLo   = na
var int   retestBarsLeft = 0
var bool  retestArmed = false
var float slAnchor = na   // structural SL for the eventual entry -- the sweep candle's own extreme

if awaitFvgConfirm
    bullFvg = awaitFvgDir == 1  and dispC1Hi < low
    bearFvg = awaitFvgDir == -1 and dispC1Lo > high
    if bullFvg or bearFvg
        fvgDir := bullFvg ? 1 : -1
        fvgHi  := bullFvg ? low       : dispC1Lo
        fvgLo  := bullFvg ? dispC1Hi  : high
        slAnchor := armedSweepExtreme
        retestArmed := true
        retestBarsLeft := staleBars
    awaitFvgConfirm := false

// ── Time filter ──────────────────────────────────────────────────────────
inHighProb = not useTimeFilter or (not na(time(timeframe.period, hpWindow)))
inBlocked  = useTimeFilter and not na(time(timeframe.period, blockedWindow))
timeOK = inHighProb and not inBlocked

// ── Retest -> entry ──────────────────────────────────────────────────────
retestHit = retestArmed and low <= fvgHi and high >= fvgLo

if retestHit
    retestArmed := false

if retestHit and timeOK and strategy.position_size == 0
    entryPx = close
    riskDist = math.abs(entryPx - slAnchor)
    if riskDist > 0
        if fvgDir == 1
            slPx = slAnchor
            t1Px = entryPx + riskDist * tgt1RR
            t2Px = entryPx + riskDist * tgt2RR
            strategy.entry("Long", strategy.long)
            strategy.exit("T1-Long", "Long", qty_percent=tgt1Pct, stop=slPx, limit=t1Px)
            strategy.exit("T2-Long", "Long", stop=slPx, limit=t2Px)
        else
            slPx = slAnchor
            t1Px = entryPx - riskDist * tgt1RR
            t2Px = entryPx - riskDist * tgt2RR
            strategy.entry("Short", strategy.short)
            strategy.exit("T1-Short", "Short", qty_percent=tgt1Pct, stop=slPx, limit=t1Px)
            strategy.exit("T2-Short", "Short", stop=slPx, limit=t2Px)

if retestArmed
    retestBarsLeft := retestBarsLeft - 1
    if retestBarsLeft <= 0
        retestArmed := false

// ── Optional breakeven move after Target 1 (flagged approximation) ─────────
if useBreakeven and strategy.position_size != 0
    entryPx2 = strategy.position_avg_price
    isLong = strategy.position_size > 0
    hitT1 = isLong ? high >= entryPx2 + math.abs(entryPx2 - slAnchor) * tgt1RR
                   : low  <= entryPx2 - math.abs(entryPx2 - slAnchor) * tgt1RR
    if hitT1
        strategy.exit("BE-Long",  "Long",  stop=entryPx2)
        strategy.exit("BE-Short", "Short", stop=entryPx2)

// ── Bias readout ─────────────────────────────────────────────────────────
var label statusLbl = na
if barstate.islast
    label.delete(statusLbl)
    biasTxt = bias == 1 ? "BULLISH" : bias == -1 ? "BEARISH" : "NEUTRAL"
    statusLbl := label.new(bar_index + 3, close, "HTF bias: " + biasTxt,
         style=label.style_label_left, color=color.new(color.black, 70), textcolor=color.white, size=size.small)
